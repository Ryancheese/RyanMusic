{
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{maicong-music/**,api/bundle.mjs}"
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/maicong-music/static/$1" },
    { "source": "/favicon.ico", "destination": "/maicong-music/favicon.ico" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
