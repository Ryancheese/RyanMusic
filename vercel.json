{
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "web-root/**"
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/web-root/static/$1" },
    { "source": "/favicon.ico", "destination": "/web-root/favicon.ico" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
